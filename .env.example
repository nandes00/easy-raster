COGNITO_USER_POOL_ID=

# Third-party API sync (set to true to enable)
SYNC_WITH_THIRDPARTY_API=false
THIRDPARTY_VEHICLE_URL=
THIRDPARTY_DEVICE_URL=

# MongoDB
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=root

# AWS (dev: LocalStack, prod: remover AWS_ENDPOINT_URL e usar credenciais reais)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

S3_BUCKET=easyraster-raw

# bus-tracking (referência — valores reais ficam no docker-compose via interpolação acima)
# dev: container local, sem TLS, replica set de 1 nó (directConnection)
# prod: cluster endpoint do DocumentDB — precisa de tls=true, tlsCAFile apontando pro
#   CA bundle embutido na imagem (Dockerfile baixa de truststore.pki.rds.amazonaws.com),
#   replicaSet=rs0 e retryWrites=false (DocumentDB não suporta retryable writes)
MONGO_URI=mongodb://root:root@localhost:27017/tracking?authSource=admin&directConnection=true
# exemplo prod: mongodb://user:pass@meucluster.xxxx.docdb.amazonaws.com:27017/tracking?tls=true&tlsCAFile=/etc/ssl/certs/global-bundle.pem&replicaSet=rs0&retryWrites=false&readPreference=secondaryPreferred
SQS_QUEUE_URL=http://localhost:4566/000000000000/tracking-raw.fifo
KAFKA_CLIENT_TOPIC=tracking.client.events

# Kafka (dev: container local, sem auth; prod: bootstrap brokers do MSK, com IAM auth via role do ECS)
KAFKA_BROKER=localhost:9094
KAFKA_IAM_AUTH=false

# Dev only (LocalStack)
AWS_ENDPOINT_URL=http://localhost:4566
